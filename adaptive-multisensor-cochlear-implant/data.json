 "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Adaptive Multisensor Perception for Cochlear Implants</title>\n<style>\n:root{\n  --bg:#f7f8fb;--fg:#1a1d24;--muted:#565d6d;--card:#ffffff;--line:#d9dce4;--edge:#7a8294;--hi:#111318;--focus:#1d4ed8;\n  --sense-f:#e3eefb;--sense-s:#2b6cb0;\n  --think-f:#ece6fb;--think-s:#6b46c1;\n  --act-f:#e2f5ea;--act-s:#2f855a;\n  --loop-f:#fdf0dc;--loop-s:#c05621;\n  --guard-f:#fde4e4;--guard-s:#c53030;\n  --tagp:#6b46c1;--tagb:#4a5568;--tagx:#b7791f;\n}\n@media (prefers-color-scheme:dark){\n  :root{\n    --bg:#0f1117;--fg:#e8eaf0;--muted:#a3a9b8;--card:#171a22;--line:#2b303c;--edge:#8a92a6;--hi:#ffffff;--focus:#93c5fd;\n    --sense-f:#16263d;--sense-s:#63a4ff;\n    --think-f:#241c3d;--think-s:#a78bfa;\n    --act-f:#12301f;--act-s:#5fd08d;\n    --loop-f:#3a2810;--loop-s:#f6ad55;\n    --guard-f:#3a1616;--guard-s:#fc8181;\n    --tagp:#a78bfa;--tagb:#a0aec0;--tagx:#f6c453;\n  }\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\nmain{max-width:1060px;margin:0 auto;padding:24px 16px 48px}\nh1{font-size:clamp(1.5rem,4vw,2.2rem);line-height:1.2;margin:.2em 0 .3em}\nh2{font-size:1.25rem;margin:2.2em 0 .6em;padding-top:.4em;border-top:1px solid var(--line)}\nh3{font-size:1rem;margin:0 0 .3em}\np{margin:.5em 0}\n.tagline{font-size:1.1rem;color:var(--muted);margin:0 0 .6em}\n.kicker{font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}\nfigure{margin:18px 0 0}\nfigcaption{font-size:.9rem;color:var(--muted);margin-top:8px}\nsvg{display:block;width:100%;height:auto}\n.tag{display:inline-block;font-size:.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-radius:999px;padding:1px 8px;border:1.5px solid currentColor;vertical-align:.1em;white-space:nowrap}\n.tag.p{color:var(--tagp)}.tag.b{color:var(--tagb)}.tag.x{color:var(--tagx)}.tag.o{color:var(--act-s)}\n.legend{display:flex;flex-wrap:wrap;gap:8px 18px;margin:12px 0 0;padding:0;list-style:none;font-size:.88rem;color:var(--muted)}\n.legend li{display:flex;align-items:center;gap:6px}\n.sw{width:16px;height:12px;border-radius:3px;border:2px solid;display:inline-block}\n.sw.sense{background:var(--sense-f);border-color:var(--sense-s)}\n.sw.think{background:var(--think-f);border-color:var(--think-s)}\n.sw.act{background:var(--act-f);border-color:var(--act-s)}\n.sw.loop{background:var(--loop-f);border-color:var(--loop-s)}\n.sw.guard{background:var(--guard-f);border-color:var(--guard-s)}\n.sw.dash{background:transparent;border-color:var(--muted);border-style:dashed}\n.ln{width:26px;height:0;border-top:2px solid var(--edge);display:inline-block}\n.ln.l{border-top:2px dashed var(--loop-s)}.ln.g{border-top:2px dotted var(--guard-s)}\n#note{min-height:3.2em;margin:12px 0 0;padding:10px 12px;border-radius:10px;background:var(--bg);border:1px solid var(--line);font-size:.95rem}\n.oneline{font-size:1.15rem;border-left:4px solid var(--think-s);padding:8px 14px;background:var(--card);border-radius:0 10px 10px 0}\n.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}\n.grid .card p{font-size:.93rem;margin:.3em 0 0}\n.two{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}\nul,ol{padding-left:1.3em}\nli{margin:.3em 0}\n.small-fig{max-width:580px;margin-left:auto;margin-right:auto}\ndetails{margin-top:10px;font-size:.92rem}\nsummary{cursor:pointer;color:var(--muted)}\nsummary:focus-visible,a:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:4px}\n.foot{margin-top:2.5em;font-size:.85rem;color:var(--muted);border-top:1px solid var(--line);padding-top:1em}\n\n/* SVG styles */\n.node,.box{--sf:var(--card);--ss:var(--edge)}\n.g-sense{--sf:var(--sense-f);--ss:var(--sense-s)}\n.g-think{--sf:var(--think-f);--ss:var(--think-s)}\n.g-act{--sf:var(--act-f);--ss:var(--act-s)}\n.g-loop{--sf:var(--loop-f);--ss:var(--loop-s)}\n.g-guard{--sf:var(--guard-f);--ss:var(--guard-s)}\n.node rect,.box rect{fill:var(--sf);stroke:var(--ss);stroke-width:2}\n.node.bg rect,.box.bg rect{stroke-dasharray:7 4}\n.node{cursor:pointer;transition:opacity .15s}\n.node:focus{outline:none}\n.node:focus-visible rect{stroke:var(--focus);stroke-width:4}\n.node.on rect{stroke-width:4}\n.t{fill:var(--fg);font-weight:600}\n.st{fill:var(--muted)}\n.head{fill:var(--muted);font-size:12px;font-weight:700;letter-spacing:.14em}\n.grp{fill:none;stroke:var(--sense-s);stroke-opacity:.5;stroke-dasharray:2 5;stroke-width:1.5}\n.e{fill:none;stroke:var(--edge);stroke-width:2;transition:opacity .15s}\n.e.l{stroke:var(--loop-s);stroke-dasharray:7 5}\n.e.g{stroke:var(--guard-s);stroke-dasharray:3 4}\n.e.hi{stroke:var(--hi);stroke-width:3.2}\n.dim{opacity:.28}\n.mk{fill:var(--edge)}.mk.l{fill:var(--loop-s)}.mk.g{fill:var(--guard-s)}.mk.h{fill:var(--hi)}\n.lbl{font-size:13px;font-style:italic;fill:var(--muted);paint-order:stroke;stroke:var(--card);stroke-width:5px;stroke-linejoin:round}\n.lbl.l{fill:var(--loop-s)}.lbl.g{fill:var(--guard-s)}\n@media (prefers-reduced-motion:reduce){.node,.e{transition:none}}\n</style>\n</head>\n<body>\n<main>\n<header>\n  <div class=\"kicker\">Concept explainer · design proposal</div>\n  <h1>Adaptive Multisensor Perception for Cochlear Implants</h1>\n  <p class=\"tagline\">Fuse several wearable sensors with deep learning so a cochlear implant adapts what it sends to the ear, moment by moment.</p>\n  <p>Cochlear implants restore access to sound, but noisy rooms, competing talkers and music remain hard for many users. This concept proposes combining several wearable sensors with compact deep-learning models so stimulation adapts to the situation and to the listener. Nothing here is a measured result: it is a design to examine and test.</p>\n  <p style=\"font-size:.9rem;color:var(--muted)\">Throughout the page: <span class=\"tag b\">Background</span> = established knowledge or existing technology. <span class=\"tag p\">Proposal</span> = part of this idea, untested. <span class=\"tag x\">Exploratory</span> = speculative even within the proposal.</p>\n</header>\n\n<figure class=\"card\" aria-labelledby=\"mainTitle\">\n  <h2 id=\"mainTitle\" style=\"margin:0 0 .5em;border:0;padding:0;font-size:1.05rem\">Main concept: sense → understand → stimulate → learn</h2>\n  <div id=\"diagram\"></div>\n  <ul class=\"legend\" aria-label=\"Legend\">\n    <li><span class=\"sw sense\"></span>Sensors (inputs)</li>\n    <li><span class=\"sw think\"></span>Learned perception</li>\n    <li><span class=\"sw act\"></span>Stimulation &amp; outcome</li>\n    <li><span class=\"sw loop\"></span>Learning loop</li>\n    <li><span class=\"sw guard\"></span>Safety layer</li>\n    <li><span class=\"sw dash\"></span>Dashed box = already exists</li>\n    <li><span class=\"ln\"></span>Signal flow</li>\n    <li><span class=\"ln l\"></span>Personalisation</li>\n    <li><span class=\"ln g\"></span>Hard constraint</li>\n  </ul>\n  <p id=\"note\" aria-live=\"polite\">Hover, tap or Tab to a box to read what it does. Enter or Space pins the note.</p>\n  <details>\n    <summary>All diagram notes as text</summary>\n    <ul id=\"allnotes\"></ul>\n  </details>\n</figure>\n\n<section>\n  <h2>The idea in one line</h2>\n  <p class=\"oneline\"><span class=\"tag p\">Proposal</span> Instead of a microphone feeding a fixed or preset program, let several body-worn sensors tell a compact deep-learning system <em>what scene the user is in and what they want to hear</em>, and let it shape electrode stimulation accordingly — inside hard safety limits and a slow, supervised personalisation loop.</p>\n</section>\n\n<section>\n  <h2>The problem it addresses</h2>\n  <ul>\n    <li><span class=\"tag b\">Background</span> A cochlear implant bypasses damaged parts of the inner ear and stimulates the auditory nerve electrically through an electrode array. Many users understand speech well in quiet conditions.</li>\n    <li><span class=\"tag b\">Background</span> Noisy places, several simultaneous talkers, reverberant rooms and music are typically much harder. Part of the reason is that electrical stimulation conveys limited spectral and temporal detail, so the ear has less to work with when sounds overlap.</li>\n    <li><span class=\"tag b\">Background</span> Current sound processors already offer directional microphones, noise reduction and automatic scene classification that switches between programs, set up by an audiologist during fitting.</li>\n    <li><span class=\"tag p\">Proposal</span> The gap this idea targets: the processor mostly \"hears\" through microphones alone and switches between a few discrete settings. It knows little about <em>where the user is looking, whether they are speaking, or which talker matters</em>, and it does not learn from how a particular person responds.</li>\n  </ul>\n</section>\n\n<section>\n  <h2>How it works — walking through the diagram</h2>\n  <ol>\n    <li><strong>Sense.</strong> <span class=\"tag p\">Proposal</span> Alongside the microphones, small sensors add non-acoustic clues: head motion, an own-voice vibration sensor, optional context, and — as an exploratory option — gaze or ear-EEG signals of attention.</li>\n    <li><strong>Fuse.</strong> The streams are aligned in time and merged into one representation. The design must assume any sensor can drop out or be noisy, and fall back gracefully to microphone-only behaviour.</li>\n    <li><strong>Understand.</strong> A compact deep network estimates the listening scene and the likely target of attention. This estimate <em>steers</em> a target-speech enhancement stage that emphasises what the user probably wants to hear.</li>\n    <li><strong>Stimulate.</strong> An adaptive mapping stage converts the cleaned signal into electrode pulse patterns, adjusting channel emphasis and compression to the scene rather than jumping between fixed programs.</li>\n    <li><strong>Guard.</strong> A non-learned safety layer enforces limits on stimulation level and processing delay. Learned components can request changes, never exceed these limits.</li>\n    <li><strong>Learn.</strong> Simple user feedback (ratings, quick overrides) and clinical fitting data slowly personalise the models, within bounds set by the clinician.</li>\n  </ol>\n\n  <figure class=\"card small-fig\" aria-labelledby=\"tsTitle\">\n    <h3 id=\"tsTitle\">Three loops on three timescales</h3>\n    <svg viewBox=\"0 0 360 290\" role=\"img\" aria-labelledby=\"tsT tsD\">\n      <title id=\"tsT\">Three adaptation loops</title>\n      <desc id=\"tsD\">A fast loop each audio frame for enhancement and mapping, a medium loop over seconds for scene and attention, and a slow loop over days to weeks for personalisation.</desc>\n      <defs>\n        <marker id=\"ts-a\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\"><path class=\"mk\" d=\"M0 0L10 5L0 10z\"/></marker>\n      </defs>\n      <g class=\"box g-act\"><rect x=\"8\" y=\"8\" width=\"344\" height=\"84\" rx=\"12\"/></g>\n      <g class=\"box g-think\"><rect x=\"8\" y=\"102\" width=\"344\" height=\"84\" rx=\"12\"/></g>\n      <g class=\"box g-loop\"><rect x=\"8\" y=\"196\" width=\"344\" height=\"84\" rx=\"12\"/></g>\n      <path class=\"e\" d=\"M66 50 A18 18 0 1 1 48 32\" marker-end=\"url(#ts-a)\"/>\n      <path class=\"e\" d=\"M66 144 A18 18 0 1 1 48 126\" marker-end=\"url(#ts-a)\"/>\n      <path class=\"e\" d=\"M66 238 A18 18 0 1 1 48 220\" marker-end=\"url(#ts-a)\"/>\n      <g font-size=\"12.5\">\n        <text class=\"t\" x=\"80\" y=\"36\" font-size=\"14\">Fast · every audio frame</text>\n        <text class=\"st\" x=\"80\" y=\"56\">Enhance target speech, map to pulses.</text>\n        <text class=\"st\" x=\"80\" y=\"74\">On the processor; tight latency budget.</text>\n        <text class=\"t\" x=\"80\" y=\"130\" font-size=\"14\">Medium · seconds</text>\n        <text class=\"st\" x=\"80\" y=\"150\">Re-estimate scene and attention target;</text>\n        <text class=\"st\" x=\"80\" y=\"168\">shift strategy smoothly, not abruptly.</text>\n        <text class=\"t\" x=\"80\" y=\"224\" font-size=\"14\">Slow · days to weeks</text>\n        <text class=\"st\" x=\"80\" y=\"244\">Personalise from feedback and fitting;</text>\n        <text class=\"st\" x=\"80\" y=\"262\">offline, clinician-approved updates.</text>\n      </g>\n    </svg>\n    <figcaption><span class=\"tag p\">Proposal</span> Separating timescales keeps the real-time path simple and predictable, while learning happens slowly and under supervision.</figcaption>\n  </figure>\n</section>\n\n<section>\n  <h2>Key components</h2>\n  <div class=\"grid\">\n    <div class=\"card\"><h3>Sensor set <span class=\"tag p\">Proposal</span></h3><p>Microphones plus head motion, own-voice detection and optional context; gaze or ear-EEG only as an exploratory add-on. Which sensors earn their cost is an open question.</p></div>\n    <div class=\"card\"><h3>Fusion with graceful fallback <span class=\"tag p\">Proposal</span></h3><p>Time-aligned merging that degrades to microphone-only behaviour when any sensor is missing, noisy or switched off.</p></div>\n    <div class=\"card\"><h3>Scene &amp; attention model <span class=\"tag p\">Proposal</span></h3><p>A compact network small enough for a behind-the-ear processor. Builds on existing scene classification <span class=\"tag b\">Background</span>, extended with attention cues.</p></div>\n    <div class=\"card\"><h3>Target-speech enhancement <span class=\"tag p\">Proposal</span></h3><p>Emphasises the attended talker. Deep-learning enhancement and separation, including work aimed at implant users, is an active research field <span class=\"tag b\">Background</span>.</p></div>\n    <div class=\"card\"><h3>Adaptive stimulation mapping <span class=\"tag p\">Proposal</span></h3><p>Adjusts how sound is turned into pulses depending on the scene, instead of switching among a few fixed programs.</p></div>\n    <div class=\"card\"><h3>Safety envelope <span class=\"tag p\">Proposal</span></h3><p>A deterministic layer that enforces stimulation and latency limits. It is deliberately not learned, so it can be verified.</p></div>\n    <div class=\"card\"><h3>Personalisation loop <span class=\"tag p\">Proposal</span></h3><p>Uses ratings, overrides and fitting data to adapt slowly, inside bounds an audiologist sets and can reset.</p></div>\n    <div class=\"card\"><h3>User control <span class=\"tag p\">Proposal</span></h3><p>A quick way to say \"not that voice\" or \"back to normal\" — so a wrong guess about attention never traps the user.</p></div>\n  </div>\n</section>\n\n<section>\n  <h2>What is new here vs what already exists</h2>\n  <div class=\"two\">\n    <div class=\"card\">\n      <h3><span class=\"tag b\">Background</span> Already exists</h3>\n      <ul>\n        <li>Electrical stimulation of the auditory nerve through an electrode array.</li>\n        <li>Directional microphones and noise reduction in sound processors.</li>\n        <li>Automatic scene classification that switches programs.</li>\n        <li>Clinical fitting by an audiologist.</li>\n        <li>Research on deep-learning speech enhancement, and on decoding auditory attention from EEG (still experimental).</li>\n        <li>Vocoder simulations used to approximate implant hearing for normal-hearing listeners, with known limitations.</li>\n      </ul>\n    </div>\n    <div class=\"card\">\n      <h3><span class=\"tag p\">Proposal</span> New in this idea</h3>\n      <ul>\n        <li>Treating non-acoustic body signals as first-class inputs, not add-ons.</li>\n        <li>One learned chain from scene and attention through to stimulation mapping.</li>\n        <li>Continuous, smooth adaptation instead of discrete program switching.</li>\n        <li>A supervised personalisation loop with clinician-set bounds.</li>\n        <li>An explicit, non-learned safety envelope as an architectural layer.</li>\n        <li>Designing for sensor drop-out from the start.</li>\n      </ul>\n      <p style=\"font-size:.88rem;color:var(--muted)\">Some of these pieces may already be explored in research; a focused literature review is one of the first next steps.</p>\n    </div>\n  </div>\n\n  <figure class=\"card small-fig\" aria-labelledby=\"cmpTitle\">\n    <h3 id=\"cmpTitle\">Comparison at a glance</h3>\n    <svg viewBox=\"0 0 360 252\" role=\"img\" aria-labelledby=\"cmpT cmpD\">\n      <title id=\"cmpT\">Typical processing compared with the proposal</title>\n      <desc id=\"cmpD\">Today: microphones, a preset program, a fixed stimulation map. Proposed: several sensors, learned fusion with scene and attention, an adaptive stimulation map, and a feedback loop back to the learned stage.</desc>\n      <defs>\n        <marker id=\"c-a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\"><path class=\"mk\" d=\"M0 0L10 5L0 10z\"/></marker>\n        <marker id=\"c-l\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\"><path class=\"mk l\" d=\"M0 0L10 5L0 10z\"/></marker>\n      </defs>\n      <text class=\"head\" x=\"8\" y=\"16\">TYPICAL TODAY</text>\n      <g class=\"box bg g-sense\"><rect x=\"8\" y=\"26\" width=\"104\" height=\"60\" rx=\"10\"/></g>\n      <g class=\"box bg g-think\"><rect x=\"128\" y=\"26\" width=\"104\" height=\"60\" rx=\"10\"/></g>\n      <g class=\"box bg g-act\"><rect x=\"248\" y=\"26\" width=\"104\" height=\"60\" rx=\"10\"/></g>\n      <path class=\"e\" d=\"M112 56 H128\" marker-end=\"url(#c-a)\"/>\n      <path class=\"e\" d=\"M232 56 H248\" marker-end=\"url(#c-a)\"/>\n      <g font-size=\"12\" text-anchor=\"middle\">\n        <text class=\"t\" x=\"60\" y=\"52\">Microphone</text><text class=\"t\" x=\"60\" y=\"68\">only</text>\n        <text class=\"t\" x=\"180\" y=\"44\">Preset program</text><text class=\"st\" x=\"180\" y=\"60\">manual or simple</text><text class=\"st\" x=\"180\" y=\"75\">classifier</text>\n        <text class=\"t\" x=\"300\" y=\"52\">Fixed</text><text class=\"t\" x=\"300\" y=\"68\">stimulation map</text>\n      </g>\n      <text class=\"head\" x=\"8\" y=\"122\">PROPOSED</text>\n      <g class=\"box g-sense\"><rect x=\"8\" y=\"132\" width=\"104\" height=\"60\" rx=\"10\"/></g>\n      <g class=\"box g-think\"><rect x=\"128\" y=\"132\" width=\"104\" height=\"60\" rx=\"10\"/></g>\n      <g class=\"box g-act\"><rect x=\"248\" y=\"132\" width=\"104\" height=\"60\" rx=\"10\"/></g>\n      <path class=\"e\" d=\"M112 162 H128\" marker-end=\"url(#c-a)\"/>\n      <path class=\"e\" d=\"M232 162 H248\" marker-end=\"url(#c-a)\"/>\n      <path class=\"e l\" d=\"M300 192 V220 H180 V194\" marker-end=\"url(#c-l)\"/>\n      <g font-size=\"12\" text-anchor=\"middle\">\n        <text class=\"t\" x=\"60\" y=\"158\">Several</text><text class=\"t\" x=\"60\" y=\"174\">sensors</text>\n        <text class=\"t\" x=\"180\" y=\"150\">Learned fusion</text><text class=\"st\" x=\"180\" y=\"166\">+ scene &amp;</text><text class=\"st\" x=\"180\" y=\"181\">attention</text>\n        <text class=\"t\" x=\"300\" y=\"158\">Adaptive</text><text class=\"t\" x=\"300\" y=\"174\">stimulation map</text>\n        <text class=\"lbl l\" x=\"240\" y=\"242\">feedback &amp; fitting</text>\n      </g>\n    </svg>\n    <figcaption>Dashed outlines mark existing approaches; solid outlines mark the proposal.</figcaption>\n  </figure>\n</section>\n\n<section>\n  <h2>Open questions and risks</h2>\n  <div class=\"two\">\n    <div class=\"card\">\n      <h3>Technical</h3>\n      <ul>\n        <li><strong>Latency and power.</strong> Can a useful model run on a behind-the-ear processor within an acceptable delay and battery budget? Unknown until measured.</li>\n        <li><strong>Training data.</strong> Implant hearing differs from acoustic hearing and between individuals. Vocoder simulations are only a proxy; data from implant users is essential and scarce.</li>\n        <li><strong>Generalisation.</strong> Will models trained on recorded scenes behave sensibly in unfamiliar rooms, languages and noise types?</li>\n        <li><strong>Which sensors matter?</strong> Each extra sensor adds cost, comfort and battery burden; some may add little. Gaze and ear-EEG in daily life are especially uncertain.</li>\n        <li><strong>Evaluation.</strong> Standard objective speech metrics may not predict what implant users actually perceive.</li>\n      </ul>\n    </div>\n    <div class=\"card\">\n      <h3>Human, clinical, ethical</h3>\n      <ul>\n        <li><strong>Wrong guesses.</strong> If the system picks the wrong talker, it may suppress the very sound the user wanted. Override and fallback design is critical.</li>\n        <li><strong>Agency and trust.</strong> Users and clinicians need to understand, at least roughly, why the sound changed.</li>\n        <li><strong>Regulation.</strong> Medical-device approval for algorithms that keep adapting after release is a hard, unresolved area.</li>\n        <li><strong>Privacy.</strong> Head motion, location context and brain signals are sensitive; on-device processing and opt-in are assumed, not guaranteed.</li>\n        <li><strong>Drift.</strong> Slow personalisation could drift into worse settings without anyone noticing; it needs monitoring and a reset.</li>\n        <li><strong>Equity.</strong> Extra hardware and fitting time could widen access gaps.</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<section>\n  <h2>Possible next steps</h2>\n  <ol>\n    <li><strong>Literature review</strong> of multisensor hearing devices, attention decoding and deep-learning enhancement for implants, to locate what is genuinely new.</li>\n    <li><strong>Define budgets</strong>: target processing delay, power, and the minimum viable sensor set, together with clinicians.</li>\n    <li><strong>Collect a small multisensor dataset</strong> of everyday scenes (audio plus head motion and own-voice signals) with consent.</li>\n    <li><strong>Offline prototype and ablation</strong>: test whether each sensor improves scene and attention estimates compared with microphones alone.</li>\n    <li><strong>Early listening tests</strong> with vocoder simulations as a rough first filter, clearly treated as a proxy.</li>\n    <li><strong>Research-processor study with implant users</strong>, measuring speech understanding in noise, listening effort, comfort and preference against their usual settings.</li>\n    <li><strong>Specify the safety envelope and override</strong> before any adaptive feature is tried with users, and consult regulators early.</li>\n  </ol>\n</section>\n\n<p class=\"foot\">This page describes a design concept. It reports no experimental results, numbers or studies; every element marked \"Proposal\" is a hypothesis to be tested. Background statements are general and should be checked against current literature before use.</p>\n</main>\n\n<script>\n(function(){\n\"use strict\";\nvar N={\n mic:{t:\"Microphone\\narray\",g:\"sense\",k:\"B\",n:\"Processors already use one or more microphones and directional processing; here they are one stream among several.\"},\n imu:{t:\"Head motion\\n(IMU)\",g:\"sense\",k:\"P\",n:\"Head orientation and movement could hint where the listener is facing and when the scene changes.\"},\n voice:{t:\"Own-voice\\nvibration sensor\",g:\"sense\",k:\"P\",n:\"A contact vibration sensor could tell the system when the user is speaking, so their own voice is treated differently.\"},\n gaze:{t:\"Gaze / ear-EEG\\n(exploratory)\",g:\"sense\",k:\"X\",n:\"Eye gaze or ear-EEG might indicate which talker the user attends to; whether this works reliably in daily life is unknown.\"},\n ctx:{t:\"Context\\n(mode, time, phone)\",g:\"sense\",k:\"P\",n:\"Coarse, opt-in context such as a user-chosen mode or paired phone state, used only as a weak hint.\"},\n fusion:{t:\"Multisensor\\nfusion\",g:\"think\",k:\"P\",n:\"Aligns the streams in time and merges them; must fall back gracefully when a sensor is missing or noisy.\"},\n scene:{t:\"Scene & attention\\nmodel (DNN)\",g:\"think\",k:\"P\",n:\"A compact deep network estimates the listening scene and the likely target of attention. Simpler scene classifiers already exist.\"},\n enh:{t:\"Target-speech\\nenhancement\",g:\"think\",k:\"P\",n:\"Emphasises the attended talker and suppresses competing sound before coding; DNN enhancement is an active research area.\"},\n map:{t:\"Adaptive\\nstimulation map\",g:\"act\",k:\"P\",n:\"Turns the cleaned signal into electrode pulse patterns, adjusting channel emphasis and compression to the scene.\"},\n safe:{t:\"Safety & latency guard (hard limits)\",g:\"guard\",k:\"P\",n:\"Fixed, verifiable limits on stimulation level and processing delay that no learned component can override.\"},\n elec:{t:\"Electrode\\nstimulation\",g:\"act\",k:\"B\",n:\"The implant stimulates the auditory nerve through a limited number of electrode contacts; this part is unchanged.\"},\n user:{t:\"What the user\\nperceives\",g:\"act\",k:\"O\",n:\"The outcome to measure: speech understanding in noise, listening effort, comfort and enjoyment of music.\"},\n fb:{t:\"Feedback &\\nfitting data\",g:\"loop\",k:\"P\",n:\"User ratings, quick overrides and clinical fitting data slowly personalise the models within clinician-set bounds.\"}\n};\nvar TAG={B:[\"Background\",\"b\"],P:[\"Proposal\",\"p\"],X:[\"Exploratory\",\"x\"],O:[\"Outcome to test\",\"o\"]};\nvar flow=[[\"fusion\",\"scene\"],[\"fusion\",\"enh\"],[\"scene\",\"enh\"],[\"scene\",\"map\"],[\"enh\",\"map\"]];\nvar LAY={\n wide:{w:1000,h:505,fs:15,lh:18,\n  pos:{mic:[16,34,180,56],imu:[16,110,180,56],voice:[16,186,180,56],gaze:[16,262,180,56],ctx:[16,338,180,56],\n   fusion:[246,180,150,64],scene:[446,80,160,64],enh:[446,280,160,64],map:[656,180,150,64],\n   safe:[246,416,560,50],elec:[846,180,144,64],user:[846,300,144,64],fb:[846,416,144,50]},\n  grp:[6,22,200,382],\n  heads:[[106,14,\"SENSE\"],[426,14,\"UNDERSTAND\"],[823,14,\"STIMULATE\"]],\n  edges:[[\"mic\",\"fusion\"],[\"imu\",\"fusion\"],[\"voice\",\"fusion\"],[\"gaze\",\"fusion\"],[\"ctx\",\"fusion\"]].concat(flow,[\n   [\"map\",\"elec\"],[\"elec\",\"user\"],[\"user\",\"fb\"],\n   [\"safe\",\"map\",\"g\",\"M731 416 V244\"],\n   [\"fb\",\"map\",\"l\",\"M846 430 C800 430 790 300 790 244\"],\n   [\"fb\",\"scene\",\"l\",\"M918 466 V492 H630 V60 H526 V80\"]]),\n  labels:[[534,216,\"steers\",\"\"],[737,398,\"limits\",\"g\"],[800,340,\"personalise\",\"l\"],[640,500,\"personalise\",\"l\"]]\n },\n narrow:{w:360,h:700,fs:13.5,lh:16,\n  pos:{mic:[16,32,154,50],imu:[190,32,154,50],voice:[16,92,154,50],gaze:[190,92,154,50],ctx:[103,152,154,50],\n   fusion:[80,240,200,50],scene:[16,316,154,54],enh:[190,316,154,54],map:[80,398,200,50],\n   safe:[16,474,328,46],elec:[16,548,154,54],user:[190,548,154,54],fb:[80,632,200,50]},\n  grp:[6,22,348,190],\n  heads:[],\n  edges:[[\"_grp\",\"fusion\",\"\",\"M180 212 V240\"]].concat(flow,[\n   [\"map\",\"safe\"],[\"safe\",\"elec\"],[\"elec\",\"user\"],[\"user\",\"fb\"],\n   [\"fb\",\"map\",\"l\",\"M280 657 H354 V423 H280\"],\n   [\"fb\",\"scene\",\"l\",\"M80 657 H6 V343 H16\"]]),\n  labels:[]\n }\n};\nvar wrap=document.getElementById(\"diagram\"),note=document.getElementById(\"note\");\nvar cur=null,pinned=null,nodes=[],edges=[];\nfunction esc(s){return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/\"/g,\"&quot;\");}\nfunction auto(a,b){\n var x1,y1,x2,y2,d;\n if(b[0]>=a[0]+a[2]-1){x1=a[0]+a[2];y1=a[1]+a[3]/2;x2=b[0];y2=b[1]+b[3]/2;d=(x2-x1)/2;\n  return \"M\"+x1+\" \"+y1+\" C\"+(x1+d)+\" \"+y1+\" \"+(x2-d)+\" \"+y2+\" \"+x2+\" \"+y2;}\n if(b[1]>=a[1]+a[3]-1){x1=a[0]+a[2]/2;y1=a[1]+a[3];x2=b[0]+b[2]/2;y2=b[1];d=(y2-y1)/2;\n  return \"M\"+x1+\" \"+y1+\" C\"+x1+\" \"+(y1+d)+\" \"+x2+\" \"+(y2-d)+\" \"+x2+\" \"+y2;}\n if(b[1]+b[3]<=a[1]){x1=a[0]+a[2]/2;y1=a[1];x2=b[0]+b[2]/2;y2=b[1]+b[3];d=(y1-y2)/2;\n  return \"M\"+x1+\" \"+y1+\" C\"+x1+\" \"+(y1-d)+\" \"+x2+\" \"+(y2+d)+\" \"+x2+\" \"+y2;}\n x1=a[0];y1=a[1]+a[3]/2;x2=b[0]+b[2];y2=b[1]+b[3]/2;d=(x1-x2)/2;\n return \"M\"+x1+\" \"+y1+\" C\"+(x1-d)+\" \"+y1+\" \"+(x2+d)+\" \"+y2+\" \"+x2+\" \"+y2;\n}\nfunction mk(id,c){return '<marker id=\"'+id+'\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto\"><path class=\"mk '+c+'\" d=\"M0 0L10 5L0 10z\"/></marker>';}\nfunction build(mode){\n var L=LAY[mode],s=\"\",i,id;\n s+='<svg viewBox=\"0 0 '+L.w+' '+L.h+'\" role=\"group\" aria-label=\"Concept diagram. Sensors feed fusion, a scene and attention model and speech enhancement, then an adaptive stimulation map under a safety guard drives the electrodes; user feedback personalises the models.\">';\n s+=\"<defs>\"+mk(\"m-n\",\"\")+mk(\"m-l\",\"l\")+mk(\"m-g\",\"g\")+mk(\"m-h\",\"h\")+\"</defs>\";\n var g=L.grp;\n s+='<rect class=\"grp\" x=\"'+g[0]+'\" y=\"'+g[1]+'\" width=\"'+g[2]+'\" height=\"'+g[3]+'\" rx=\"14\"/>';\n for(i=0;i<L.heads.length;i++){var h=L.heads[i];s+='<text class=\"head\" x=\"'+h[0]+'\" y=\"'+h[1]+'\" text-anchor=\"middle\">'+h[2]+\"</text>\";}\n for(i=0;i<L.edges.length;i++){\n  var e=L.edges[i],k=e[2]||\"\",d=e[3]||auto(L.pos[e[0]],L.pos[e[1]]);\n  s+='<path class=\"e '+k+'\" data-f=\"'+e[0]+'\" data-t=\"'+e[1]+'\" data-k=\"'+k+'\" d=\"'+d+'\" marker-end=\"url(#m-'+(k||\"n\")+')\"/>';\n }\n for(i=0;i<L.labels.length;i++){var b=L.labels[i];s+='<text class=\"lbl '+b[3]+'\" x=\"'+b[0]+'\" y=\"'+b[1]+'\" text-anchor=\"middle\">'+b[2]+\"</text>\";}\n for(id in N){\n  var n=N[id],p=L.pos[id],lines=n.t.split(\"\\n\"),cx=p[0]+p[2]/2,cy=p[1]+p[3]/2,y0=cy-(lines.length-1)*L.lh/2;\n  s+='<g class=\"node g-'+n.g+(n.k===\"B\"?\" bg\":\"\")+'\" data-id=\"'+id+'\" tabindex=\"0\" role=\"button\" aria-pressed=\"false\" aria-label=\"'+esc(lines.join(\" \")+\". \"+TAG[n.k][0]+\". \"+n.n)+'\">';\n  s+='<rect x=\"'+p[0]+'\" y=\"'+p[1]+'\" width=\"'+p[2]+'\" height=\"'+p[3]+'\" rx=\"10\"/>';\n  s+='<text class=\"t\" text-anchor=\"middle\" font-size=\"'+L.fs+'\">';\n  for(var j=0;j<lines.length;j++){s+='<tspan x=\"'+cx+'\" y=\"'+(y0+j*L.lh)+'\" dominant-baseline=\"central\">'+esc(lines[j])+\"</tspan>\";}\n  s+=\"</text></g>\";\n }\n s+=\"</svg>\";\n wrap.innerHTML=s;\n nodes=[].slice.call(wrap.querySelectorAll(\".node\"));\n edges=[].slice.call(wrap.querySelectorAll(\".e\"));\n nodes.forEach(function(el){\n  var id=el.getAttribute(\"data-id\");\n  el.addEventListener(\"mouseenter\",function(){apply(id);});\n  el.addEventListener(\"mouseleave\",function(){apply(pinned);});\n  el.addEventListener(\"focus\",function(){apply(id);});\n  el.addEventListener(\"blur\",function(){apply(pinned);});\n  el.addEventListener(\"click\",function(){toggle(id);});\n  el.addEventListener(\"keydown\",function(ev){\n   if(ev.key===\"Enter\"||ev.key===\" \"){ev.preventDefault();toggle(id);}\n   else if(ev.key===\"Escape\"){pinned=null;apply(id);syncPressed();}\n  });\n });\n syncPressed();apply(pinned);\n}\nfunction touches(e,id){\n var f=e.getAttribute(\"data-f\"),t=e.getAttribute(\"data-t\");\n return f===id||t===id||(f===\"_grp\"&&N[id]&&N[id].g===\"sense\");\n}\nfunction apply(id){\n var nb={};\n edges.forEach(function(e){\n  var on=id&&touches(e,id);\n  e.classList.toggle(\"hi\",!!on);\n  e.classList.toggle(\"dim\",!!id&&!on);\n  var k=e.getAttribute(\"data-k\")||\"n\";\n  e.setAttribute(\"marker-end\",\"url(#m-\"+(on?\"h\":k)+\")\");\n  if(on){var f=e.getAttribute(\"data-f\"),t=e.getAttribute(\"data-t\");\n   if(f===\"_grp\"){for(var x in N){if(N[x].g===\"sense\")nb[x]=1;}}else nb[f]=1; nb[t]=1;}\n });\n nodes.forEach(function(el){\n  var i=el.getAttribute(\"data-id\");\n  el.classList.toggle(\"on\",i===id);\n  el.classList.toggle(\"dim\",!!id&&i!==id&&!nb[i]);\n });\n if(id&&N[id]){\n  var n=N[id],tg=TAG[n.k];\n  note.innerHTML='<span class=\"tag '+tg[1]+'\">'+tg[0]+\"</span> <strong>\"+esc(n.t.replace(\"\\n\",\" \"))+\"</strong> — \"+esc(n.n)+(pinned===id?' <em style=\"color:var(--muted)\">(pinned)</em>':\"\");\n } else {\n  note.textContent=\"Hover, tap or Tab to a box to read what it does. Enter or Space pins the note.\";\n }\n}\nfunction toggle(id){pinned=(pinned===id)?null:id;syncPressed();apply(pinned||id);}\nfunction syncPressed(){nodes.forEach(function(el){el.setAttribute(\"aria-pressed\",el.getAttribute(\"data-id\")===pinned?\"true\":\"false\");});}\nfunction render(){\n var mode=(wrap.clientWidth||window.innerWidth)<640?\"narrow\":\"wide\";\n if(mode===cur)return;cur=mode;\n var focused=document.activeElement&&document.activeElement.getAttribute&&document.activeElement.getAttribute(\"data-id\");\n build(mode);\n if(focused){var el=wrap.querySelector('[data-id=\"'+focused+'\"]');if(el)el.focus();}\n}\nvar list=document.getElementById(\"allnotes\"),html=\"\";\nfor(var id in N){var n=N[id];html+='<li><span class=\"tag '+TAG[n.k][1]+'\">'+TAG[n.k][0]+\"</span> <strong>\"+esc(n.t.replace(\"\\n\",\" \"))+\"</strong> — \"+esc(n.n)+\"</li>\";}\nlist.innerHTML=html;\nrender();\nif(typeof ResizeObserver!==\"undefined\"){new ResizeObserver(render).observe(wrap);}\nelse{window.addEventListener(\"resize\",render);}\n})();\n</script>\n</body>\n</html>",
