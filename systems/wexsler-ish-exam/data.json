 "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>The Wexsler-ish Exam (A Parody)</title>\n<style>\n:root{--bg:#fbfaf7;--fg:#1d1d1f;--muted:#5c5c66;--card:#fff;--line:#ddd8cc;--acc:#3b5bdb;--acc2:#d9480f;--good:#2b8a3e;--bad:#c92a2a;--shade:rgba(59,91,219,.18);--band:rgba(217,72,15,.13)}\n@media (prefers-color-scheme:dark){:root{--bg:#15161a;--fg:#ececf1;--muted:#a3a3ae;--card:#1f2128;--line:#363945;--acc:#91a7ff;--acc2:#ffa94d;--good:#69db7c;--bad:#ff8787;--shade:rgba(145,167,255,.22);--band:rgba(255,169,77,.16)}}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:760px;margin:0 auto;padding:16px}\nheader{padding:20px 0 8px}\nh1{font-size:1.7rem;margin:0 0 4px;line-height:1.2}\nh2{font-size:1.25rem;margin:0 0 10px}\nh3{font-size:1.05rem;margin:0 0 10px}\np{margin:0 0 10px}\n.muted{color:var(--muted);font-size:.92rem}\n.tag{display:inline-block;background:var(--acc2);color:#fff;font-size:.75rem;font-weight:700;padding:2px 8px;border-radius:99px;letter-spacing:.04em}\n@media (prefers-color-scheme:dark){.tag{color:#15161a}}\nsection{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin:16px 0}\n.num{font-size:.8rem;color:var(--acc);font-weight:700;text-transform:uppercase;letter-spacing:.08em}\nbutton{font:inherit;cursor:pointer;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--fg);padding:10px 14px;min-height:44px}\nbutton:hover{border-color:var(--acc)}\nbutton.primary{background:var(--acc);color:#fff;border-color:var(--acc);font-weight:600}\n@media (prefers-color-scheme:dark){button.primary{color:#15161a}}\nbutton:disabled{cursor:default;opacity:.75}\n:focus-visible{outline:3px solid var(--acc2);outline-offset:2px}\n.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}\n.opts{display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));margin:8px 0}\n.opts button.right{border-color:var(--good);box-shadow:inset 0 0 0 2px var(--good)}\n.opts button.wrong{border-color:var(--bad);box-shadow:inset 0 0 0 2px var(--bad)}\n.bar{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:6px 0 14px}\n.bar i{display:block;height:100%;background:var(--acc);width:0;transition:width .3s}\n.fb{min-height:1.5em;margin:8px 0}\n.digits{font-size:2.4rem;letter-spacing:.4em;font-weight:700;text-align:center;padding:10px 0;font-variant-numeric:tabular-nums}\ninput[type=text]{font:inherit;font-size:1.4rem;letter-spacing:.3em;padding:8px 10px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--fg);width:9em;min-height:44px}\n.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;max-width:340px;margin:10px 0}\n.grid button{font-size:1.5rem;padding:4px;aspect-ratio:1;min-height:44px}\n.grid button.hit{background:var(--good);color:#fff;border-color:var(--good)}\n.grid button.miss{background:var(--bad);color:#fff;border-color:var(--bad)}\n.big{font-size:3rem;font-weight:800;line-height:1.1;color:var(--acc);font-variant-numeric:tabular-nums;word-break:break-all}\nsvg{width:100%;height:auto;display:block;margin:8px 0}\n.curve{fill:none;stroke:var(--fg);stroke-width:2}\n.fill{fill:var(--shade)}\n.band{fill:var(--band)}\n.axis{stroke:var(--muted);stroke-width:1}\n.tick{fill:var(--muted);font-size:10px;text-anchor:middle}\n.mk{stroke-width:2.5}.mk.a{stroke:var(--acc)}.mk.b{stroke:var(--acc2);stroke-dasharray:5 3}\n.ml{font-size:11px;font-weight:700;text-anchor:middle}.ml.a{fill:var(--acc)}.ml.b{fill:var(--acc2)}\ntable{border-collapse:collapse;width:100%;font-size:.95rem}\ntd{padding:6px 4px;border-bottom:1px solid var(--line)}\ntd:last-child{text-align:right;font-variant-numeric:tabular-nums}\nol.steps{padding-left:1.3em;margin:0}\nol.steps li{margin-bottom:12px}\n.val{font-weight:700;color:var(--acc);font-variant-numeric:tabular-nums}\nselect{font:inherit;padding:8px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--fg);min-height:44px;max-width:100%}\n.slider{margin:10px 0}\n.slider label{display:flex;justify-content:space-between;gap:8px;font-size:.95rem}\n.slider output{font-variant-numeric:tabular-nums;color:var(--muted);white-space:nowrap}\ninput[type=range]{width:100%;accent-color:var(--acc);min-height:32px}\n.compare{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0}\n.box{border:1px solid var(--line);border-radius:10px;padding:10px;text-align:center}\n.box b{display:block;font-size:1.8rem;font-variant-numeric:tabular-nums}\n.box.a b{color:var(--acc)}.box.b b{color:var(--acc2)}\nfieldset{border:1px solid var(--line);border-radius:10px;padding:10px;margin:10px 0}\nlegend{font-weight:600;padding:0 4px}\n.radio{display:flex;align-items:center;gap:8px;padding:4px 0;min-height:36px}\n.radio input,.chk input{width:20px;height:20px;accent-color:var(--acc)}\n.chk{display:flex;align-items:center;gap:8px;margin:10px 0;min-height:36px}\nul.notes{padding-left:1.2em;margin:8px 0 0}\nul.notes li{margin-bottom:6px}\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin:10px 0}\n.cards button{text-align:left;display:flex;flex-direction:column;gap:2px}\n.cards button span{font-size:.85rem;color:var(--muted)}\n.cards button[aria-pressed=true]{border-color:var(--acc2);box-shadow:inset 0 0 0 2px var(--acc2)}\nfooter{color:var(--muted);font-size:.85rem;padding:8px 0 30px}\n.hidden{display:none}\n.sample{background:var(--band);border-radius:8px;padding:6px 10px;font-size:.9rem}\n</style>\n</head>\n<body>\n<main>\n<header>\n<span class=\"tag\">PARODY</span>\n<h1>The Wexsler-ish Exam</h1>\n<p>A tiny, very unofficial \"intelligence\" test. It gives you one confident number. Then it shows how wobbly that number is.</p>\n<p class=\"muted\">This is not a real IQ test. It is not linked to any real test or publisher. All groups and weights here are made up.</p>\n</header>\n\n<section id=\"s1\" aria-labelledby=\"h1s\">\n<div class=\"num\">Section 1</div>\n<h2 id=\"h1s\">Test: your result</h2>\n<div id=\"intro\">\n<p>Six short items. Some are timed. Fast answers earn a bonus, because tests often reward speed.</p>\n<div class=\"row\">\n<button class=\"primary\" id=\"start\">Start the test</button>\n<button id=\"skip\">Skip: fill in random answers</button>\n</div>\n</div>\n<div id=\"test\" class=\"hidden\">\n<div id=\"prog\" class=\"muted\"></div>\n<div class=\"bar\" aria-hidden=\"true\"><i id=\"barI\"></i></div>\n<div id=\"qArea\"></div>\n<div class=\"fb\" id=\"fb\" aria-live=\"polite\"></div>\n<button class=\"primary hidden\" id=\"next\">Next</button>\n</div>\n<div id=\"result\" class=\"hidden\">\n<h3 id=\"resH\" tabindex=\"-1\">Your official-looking number</h3>\n<div class=\"big\" id=\"resScore\">–</div>\n<p id=\"resPct\"></p>\n<svg id=\"c1\" viewBox=\"0 0 320 160\" role=\"img\" aria-label=\"Bell curve\"></svg>\n<table id=\"resTable\"></table>\n<p class=\"muted\">The bell curve shows how scores spread out in a group. Most people sit near the middle. The shaded part is the share of the group below you.</p>\n<div class=\"row\"><button id=\"again\">Take it again</button></div>\n</div>\n</section>\n\n<section id=\"s2\" aria-labelledby=\"h2s\">\n<div class=\"num\">Section 2</div>\n<h2 id=\"h2s\">How the scoring works</h2>\n<p class=\"sample hidden\" id=\"sm2\">No test taken yet. Using a sample of 5 raw points.</p>\n<ol class=\"steps\">\n<li><b>Count raw points.</b> You earned <span class=\"val\" id=\"pRaw\"></span> of 8 points.</li>\n<li><b>Pick a comparison group.</b> Your score only means something next to other people's.<br>\n<label for=\"norm\" class=\"muted\">Group:</label>\n<select id=\"norm\">\n<option value=\"avg\">Imaginary everyday crowd</option>\n<option value=\"club\">Imaginary puzzle club</option>\n<option value=\"sleepy\">Imaginary 3 a.m. crowd</option>\n</select><br>\n<span class=\"muted\">This made-up group averages <span class=\"val\" id=\"pM\"></span> points, with a typical spread of <span class=\"val\" id=\"pSd\"></span>.</span></li>\n<li><b>Find your z-score.</b> A z-score says how many \"typical spreads\" you are above or below the group average.<br>\nz = (<span id=\"pR2\"></span> − <span id=\"pM2\"></span>) ÷ <span id=\"pSd2\"></span> = <span class=\"val\" id=\"pZ\"></span></li>\n<li><b>Stretch it to the familiar scale.</b> Many IQ-style tests set the average at 100. One typical spread (a \"standard deviation\") becomes 15 points.<br>\nscore = 100 + 15 × <span id=\"pZ2\"></span> = <span class=\"val\" id=\"pS\"></span></li>\n<li><b>Turn it into a percentile.</b> A percentile is the share of the group that scores below you. Here it is about <span class=\"val\" id=\"pP\"></span>.</li>\n</ol>\n<p class=\"muted\">Real tests build their groups from large samples of real people. This page uses invented numbers, so the result means nothing.</p>\n</section>\n\n<section id=\"s3\" aria-labelledby=\"h3s\">\n<div class=\"num\">Section 3</div>\n<h2 id=\"h3s\">Hidden variables that move the score</h2>\n<p>Your answers are fixed. But imagine you took the test on a different day. Move the sliders.</p>\n<div id=\"sliders\"></div>\n<div class=\"compare\">\n<div class=\"box a\"><span class=\"muted\">Score as taken</span><b id=\"hA\">–</b></div>\n<div class=\"box b\"><span class=\"muted\">On that other day</span><b id=\"hB\">–</b></div>\n</div>\n<p id=\"hMsg\" aria-live=\"polite\"></p>\n<svg id=\"c2\" viewBox=\"0 0 320 160\" role=\"img\" aria-label=\"Bell curve with two scores\"></svg>\n<p class=\"muted\">The weights on this page are invented. Research does find that sleep, stress, practice and language can affect test results. The sizes here are not real.</p>\n<div class=\"row\"><button id=\"hReset\">Reset sliders</button></div>\n</section>\n\n<section id=\"s4\" aria-labelledby=\"h4s\">\n<div class=\"num\">Section 4</div>\n<h2 id=\"h4s\">Statistical sleight of hand</h2>\n<p>Same answers. Let's change only how we report them.</p>\n<div class=\"row\"><button id=\"flatter\">Pick the most flattering group</button></div>\n<p class=\"muted\" id=\"flatMsg\" aria-live=\"polite\"></p>\n<label for=\"old\"><b>Compare against norms from:</b></label><br>\n<select id=\"old\">\n<option value=\"0\">This year</option>\n<option value=\"1\">10 years ago</option>\n<option value=\"2\">20 years ago</option>\n<option value=\"3\">30 years ago</option>\n</select>\n<fieldset>\n<legend>Report the result as</legend>\n<label class=\"radio\"><input type=\"radio\" name=\"fmt\" value=\"whole\" checked> A whole number</label>\n<label class=\"radio\"><input type=\"radio\" name=\"fmt\" value=\"precise\"> A very precise number</label>\n<label class=\"radio\"><input type=\"radio\" name=\"fmt\" value=\"pct\"> A percentile</label>\n<label class=\"radio\"><input type=\"radio\" name=\"fmt\" value=\"best\"> My best item only</label>\n<label class=\"radio\"><input type=\"radio\" name=\"fmt\" value=\"label\"> A catchy label</label>\n</fieldset>\n<label class=\"chk\"><input type=\"checkbox\" id=\"bandChk\"> Show an honest error band</label>\n<p class=\"muted\">The reported result:</p>\n<div class=\"big\" id=\"rep\" aria-live=\"polite\">–</div>\n<svg id=\"c3\" viewBox=\"0 0 320 160\" role=\"img\" aria-label=\"Bell curve for the reported score\"></svg>\n<ul class=\"notes\" id=\"tricks\"></ul>\n</section>\n\n<section id=\"s5\" aria-labelledby=\"h5s\">\n<div class=\"num\">Section 5</div>\n<h2 id=\"h5s\">What the number cannot see</h2>\n<p>Tap a card to \"measure\" it.</p>\n<div class=\"cards\" id=\"cards\"></div>\n<p id=\"cardMsg\" aria-live=\"polite\" class=\"muted\">Measured so far: 0 of 0.</p>\n</section>\n\n<footer>\n<p>Made as a parody of one-number thinking. Real intelligence tests are long, given by trained people, and read with care. This page is none of those things.</p>\n<p>The name is a playful nod to well-known test batteries. No real test items are used.</p>\n</footer>\n</main>\n\n<script>\n(function(){\nvar $=function(id){return document.getElementById(id)};\nvar norms={avg:{n:'Imaginary everyday crowd',m:5,sd:1.5},club:{n:'Imaginary puzzle club',m:6.6,sd:0.9},sleepy:{n:'Imaginary 3 a.m. crowd',m:3.6,sd:1.6}};\nvar MAX=8;\nvar items=[\n{t:'mc',name:'Number pattern',q:'What comes next? 3, 6, 12, 24, …',o:['30','36','48','42'],a:2},\n{t:'mc',name:'Odd one out',q:'Which one does not belong? 🍎 🍌 🥕 🍇',o:['🍎 Apple','🍌 Banana','🥕 Carrot','🍇 Grapes'],a:2,note:'But the banana is the only long one. The grapes are the only bunch. Many answers make sense. The test accepts only one.'},\n{t:'mc',name:'Word meaning',q:'Which word is closest in meaning to \"brief\"?',o:['bright','short','heavy','loud'],a:1,note:'This item checks English words as much as thinking.'},\n{t:'mem',name:'Digit memory'},\n{t:'mc',name:'Logic',q:'All bloops are razzies. All razzies are lazzies. Are all bloops lazzies?',o:['Yes','No','Cannot tell'],a:0},\n{t:'speed',name:'Star hunt'}\n];\nitems.forEach(function(it){it.max=it.t==='mc'?1.5:1});\nvar st={i:0,res:[],raw:null,norm:'avg'};\nvar timers=[];\nfunction clearTimers(){timers.forEach(function(t){clearTimeout(t);clearInterval(t)});timers=[]}\n\nfunction erf(x){var t=1/(1+0.3275911*Math.abs(x));var y=1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*Math.exp(-x*x);return x>=0?y:-y}\nfunction cdf(z){return 0.5*(1+erf(z/Math.SQRT2))}\nfunction clamp(v,a,b){return Math.max(a,Math.min(b,v))}\nfunction calc(raw,key){var n=norms[key];var z=(raw-n.m)/n.sd;var s=clamp(100+15*z,40,160);return{z:z,s:s,p:cdf((s-100)/15)*100}}\nfunction f1(v){return (Math.round(v*10)/10).toFixed(1)}\nfunction f2(v){return (Math.round(v*100)/100).toFixed(2)}\nfunction ord(p){return Math.round(clamp(p,0.1,99.9))+'%'}\n\nfunction drawCurve(svg,marks,band){\n var X=function(s){return 20+(s-40)/120*280},Y=function(s){return 120-100*Math.exp(-Math.pow((s-100)/15,2)/2)};\n var d='',s,h='';\n for(s=40;s<=160;s+=2)d+=(s===40?'M':'L')+X(s).toFixed(1)+' '+Y(s).toFixed(1);\n if(band){var a=clamp(band[0],40,160),b=clamp(band[1],40,160);h+='<rect x=\"'+X(a)+'\" y=\"15\" width=\"'+(X(b)-X(a))+'\" height=\"105\" class=\"band\"/>'}\n if(marks[0]){var m=clamp(marks[0].s,40,160),ap='M'+X(40)+' 120';for(s=40;s<=m;s+=1)ap+='L'+X(s).toFixed(1)+' '+Y(s).toFixed(1);ap+='L'+X(m).toFixed(1)+' '+Y(m).toFixed(1)+'L'+X(m).toFixed(1)+' 120Z';h+='<path d=\"'+ap+'\" class=\"fill\"/>'}\n h+='<path d=\"'+d+'\" class=\"curve\"/><line x1=\"20\" y1=\"120\" x2=\"300\" y2=\"120\" class=\"axis\"/>';\n [55,70,85,100,115,130,145].forEach(function(t){h+='<line x1=\"'+X(t)+'\" y1=\"120\" x2=\"'+X(t)+'\" y2=\"124\" class=\"axis\"/><text x=\"'+X(t)+'\" y=\"135\" class=\"tick\">'+t+'</text>'});\n marks.forEach(function(mk,i){var x=X(clamp(mk.s,40,160)),lx=clamp(x,34,286);h+='<line x1=\"'+x+'\" y1=\"'+(i?120:16)+'\" x2=\"'+x+'\" y2=\"'+(i?140:120)+'\" class=\"mk '+mk.c+'\"/><text x=\"'+lx+'\" y=\"'+(i?153:11)+'\" class=\"ml '+mk.c+'\">'+mk.l+'</text>'});\n svg.innerHTML=h;\n svg.setAttribute('aria-label','Bell curve from 40 to 160. '+marks.map(function(m){return m.l}).join('. '));\n}\n\n/* ---------- Test ---------- */\nvar qArea=$('qArea'),fb=$('fb'),nextBtn=$('next');\nfunction el(tag,props,text){var e=document.createElement(tag);for(var k in props)e.setAttribute(k,props[k]);if(text!=null)e.textContent=text;return e}\nfunction begin(){st.i=0;st.res=[];$('intro').classList.add('hidden');$('result').classList.add('hidden');$('test').classList.remove('hidden');show()}\nfunction record(pts){var it=items[st.i];st.res.push({name:it.name,pts:pts,max:it.max});nextBtn.classList.remove('hidden');nextBtn.textContent=st.i===items.length-1?'See my number':'Next';nextBtn.focus()}\nfunction show(){\n clearTimers();var it=items[st.i];qArea.innerHTML='';fb.textContent='';nextBtn.classList.add('hidden');\n $('prog').textContent='Item '+(st.i+1)+' of '+items.length+' — '+it.name;\n $('barI').style.width=(st.i/items.length*100)+'%';\n if(it.t==='mc')showMC(it);else if(it.t==='mem')showMem();else showSpeed();\n}\nfunction showMC(it){\n var h=el('h3',{tabindex:'-1'},it.q);qArea.appendChild(h);\n var box=el('div',{class:'opts'});var t0=performance.now();\n it.o.forEach(function(o,k){var b=el('button',{type:'button'},o);b.onclick=function(){\n  var dt=performance.now()-t0,ok=k===it.a,fast=dt<5000;\n  Array.prototype.forEach.call(box.children,function(c){c.disabled=true});\n  b.classList.add(ok?'right':'wrong');if(!ok)box.children[it.a].classList.add('right');\n  var pts=ok?(1+(fast?0.5:0)):0;\n  fb.textContent=(ok?'Expected answer. '+(fast?'Fast, too: +0.5 speed bonus.':'No speed bonus (over 5 seconds).'):'Not the expected answer. 0 points.')+(it.note?' '+it.note:'');\n  record(pts)};box.appendChild(b)});\n qArea.appendChild(box);h.focus();\n}\nfunction showMem(){\n var digits='';for(var k=0;k<5;k++)digits+=Math.floor(Math.random()*10);\n qArea.appendChild(el('p',{},'Press Show. Five digits appear for 3 seconds. Then type them in the same order.'));\n var b=el('button',{type:'button',class:'primary'},'Show digits');qArea.appendChild(b);b.focus();\n b.onclick=function(){\n  b.remove();var d=el('div',{class:'digits','aria-live':'assertive'},digits.split('').join(' '));qArea.appendChild(d);\n  timers.push(setTimeout(function(){\n   d.remove();var row=el('div',{class:'row'});var lab=el('label',{for:'memIn'},'Digits:');\n   var inp=el('input',{type:'text',id:'memIn',inputmode:'numeric',maxlength:'5',autocomplete:'off'});\n   var c=el('button',{type:'button',class:'primary'},'Check');\n   row.appendChild(lab);row.appendChild(inp);row.appendChild(c);qArea.appendChild(row);inp.focus();\n   function check(){var v=inp.value.replace(/\\D/g,''),m=0;for(var k=0;k<5;k++)if(v[k]===digits[k])m++;\n    inp.disabled=true;c.disabled=true;fb.textContent='You got '+m+' of 5 digits in the right place. The digits were '+digits+'.';record(m/5)}\n   c.onclick=check;inp.onkeydown=function(e){if(e.key==='Enter')check()};\n  },3000));\n };\n}\nfunction showSpeed(){\n qArea.appendChild(el('p',{},'Tap every ★ (filled star). You have 8 seconds. Wrong taps cost half a star.'));\n var b=el('button',{type:'button',class:'primary'},'Start the hunt');qArea.appendChild(b);b.focus();\n b.onclick=function(){\n  b.remove();var others=[['☆','outline star'],['✦','four-point star'],['●','dot'],['◆','diamond'],['✧','outline four-point star']];\n  var cells=[],k;for(k=0;k<5;k++)cells.push(['★','filled star',1]);for(k=0;k<15;k++){var o=others[k%others.length];cells.push([o[0],o[1],0])}\n  for(k=cells.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1)),tmp=cells[k];cells[k]=cells[j];cells[j]=tmp}\n  var timer=el('p',{class:'muted'},'8.0 seconds left');qArea.appendChild(timer);\n  var g=el('div',{class:'grid'}),found=0,wrong=0,done=false,end=performance.now()+8000;\n  cells.forEach(function(c){var btn=el('button',{type:'button','aria-label':c[1]},c[0]);btn.onclick=function(){if(done)return;btn.disabled=true;\n   if(c[2]){found++;btn.classList.add('hit');if(found===5)finishHunt()}else{wrong++;btn.classList.add('miss')}};g.appendChild(btn)});\n  qArea.appendChild(g);g.firstChild.focus();\n  function finishHunt(){if(done)return;done=true;clearTimers();Array.prototype.forEach.call(g.children,function(c){c.disabled=true});\n   var pts=Math.max(0,(found-0.5*wrong)/5);timer.textContent='Time!';\n   fb.textContent='Found '+found+' of 5 stars, with '+wrong+' wrong tap'+(wrong===1?'':'s')+'. Points: '+f2(pts)+' of 1.';record(pts)}\n  timers.push(setInterval(function(){var left=Math.max(0,(end-performance.now())/1000);timer.textContent=left.toFixed(1)+' seconds left';if(left<=0)finishHunt()},100));\n };\n}\nnextBtn.onclick=function(){st.i++;if(st.i<items.length)show();else finish()};\nfunction finish(){\n clearTimers();st.raw=st.res.reduce(function(a,r){return a+r.pts},0);\n $('test').classList.add('hidden');$('result').classList.remove('hidden');\n var t='';st.res.forEach(function(r){t+='<tr><td>'+r.name+'</td><td>'+f2(r.pts)+' / '+r.max+'</td></tr>'});\n t+='<tr><td><b>Raw total</b></td><td><b>'+f2(st.raw)+' / '+MAX+'</b></td></tr>';$('resTable').innerHTML=t;\n update();$('resH').focus();\n}\n$('start').onclick=begin;\n$('again').onclick=begin;\n$('skip').onclick=function(){st.res=items.map(function(it){var p=it.t==='mc'?(Math.random()<0.65?(Math.random()<0.5?1.5:1):0):Math.round(Math.random()*5)/5;return{name:it.name,pts:p,max:it.max}});\n $('intro').classList.add('hidden');finish()};\n\n/* ---------- Hidden variables ---------- */\nvar hv=[\n{id:'sleep',l:'Hours of sleep last night',min:3,max:10,v:7,u:' h',f:function(v){return(Math.min(v,8)-7)*0.25}},\n{id:'coffee',l:'Cups of coffee or tea',min:0,max:6,v:1,u:'',f:function(v){return(0.3*v-0.08*v*v)-0.22}},\n{id:'nerves',l:'Nervousness (0 calm, 10 very nervous)',min:0,max:10,v:3,u:'',f:function(v){return-(v-3)*0.12}},\n{id:'lang',l:'How well you know the test language (0–10)',min:0,max:10,v:10,u:'',f:function(v){return(v-10)*0.15}},\n{id:'prac',l:'Times you have seen puzzles like these',min:0,max:5,v:0,u:'',f:function(v){return v*0.25}},\n{id:'noise',l:'Room noise (0 quiet, 10 loud)',min:0,max:10,v:2,u:'',f:function(v){return-(v-2)*0.06}}\n];\nvar sl=$('sliders');\nhv.forEach(function(h){var w=el('div',{class:'slider'});\n w.innerHTML='<label for=\"hv_'+h.id+'\"><span>'+h.l+'</span><output id=\"o_'+h.id+'\"></output></label><input type=\"range\" id=\"hv_'+h.id+'\" min=\"'+h.min+'\" max=\"'+h.max+'\" step=\"1\" value=\"'+h.v+'\">';\n sl.appendChild(w);w.querySelector('input').oninput=update});\n$('hReset').onclick=function(){hv.forEach(function(h){$('hv_'+h.id).value=h.v});update()};\n\n/* ---------- Cards ---------- */\nvar cards=[['🤝','Kindness'],['🔍','Curiosity'],['😄','Humor'],['⏳','Patience'],['🎨','Making new things'],['🚲','Fixing a bike'],['🫂','Comforting a friend'],['🍅','Growing tomatoes'],['🗺️','Knowing your neighborhood'],['🔁','Learning from mistakes'],['🎶','Keeping a rhythm'],['🧭','Doing the right thing']];\nvar cg=$('cards'),measured=0;\ncards.forEach(function(c){var b=el('button',{type:'button','aria-pressed':'false'});b.innerHTML='<b>'+c[0]+' '+c[1]+'</b><span>Tap to measure</span>';\n b.onclick=function(){if(b.getAttribute('aria-pressed')==='false'){b.setAttribute('aria-pressed','true');measured++}\n  b.querySelector('span').textContent='Measured value: — (no item for this)';\n  $('cardMsg').textContent='Measured so far: '+measured+' of '+cards.length+'. The test has no item for any of them.'+(measured===cards.length?' They still matter.':'')};cg.appendChild(b)});\n$('cardMsg').textContent='Measured so far: 0 of '+cards.length+'.';\n\n/* ---------- Update everything ---------- */\n$('norm').onchange=function(){st.norm=this.value;$('flatMsg').textContent='';update()};\n$('old').onchange=update;$('bandChk').onchange=update;\nArray.prototype.forEach.call(document.querySelectorAll('input[name=fmt]'),function(r){r.onchange=update});\n$('flatter').onclick=function(){var r=st.raw==null?5:st.raw,best='avg';for(var k in norms)if(calc(r,k).s>calc(r,best).s)best=k;\n st.norm=best;$('norm').value=best;$('flatMsg').textContent='Picked: '+norms[best].n+'. Your answers did not change.';update()};\n\nfunction label(s){return s<80?'Mysteriously Undermeasured':s<95?'Gloriously Typical-ish':s<105?'Statistically Beige':s<120?'Suspiciously Above Beige':'Wexsler-ishly Luminous'}\n\nfunction update(){\n var sample=st.raw==null,r=sample?5:st.raw,n=norms[st.norm],c=calc(r,st.norm);\n $('sm2').classList.toggle('hidden',!sample);\n // Section 1\n if(!sample){$('resScore').textContent=Math.round(c.s);\n  $('resPct').textContent='Compared with the '+n.n.toLowerCase()+', about '+ord(c.p)+' would score below you. Group and numbers are invented.';\n  drawCurve($('c1'),[{s:c.s,l:'You: '+Math.round(c.s),c:'a'}])}\n // Section 2\n $('pRaw').textContent=f2(r);$('pR2').textContent=f2(r);$('pM').textContent=n.m;$('pM2').textContent=n.m;$('pSd').textContent=n.sd;$('pSd2').textContent=n.sd;\n $('pZ').textContent=f2(c.z);$('pZ2').textContent=f2(c.z);$('pS').textContent=f1(100+15*c.z)+(c.s!==100+15*c.z?' (capped at '+Math.round(c.s)+')':'');$('pP').textContent=ord(c.p);\n // Section 3\n var tot=0;hv.forEach(function(h){var v=+$('hv_'+h.id).value,e=h.f(v);tot+=e;$('o_'+h.id).textContent=v+h.u+'  ('+(e>=0?'+':'')+f2(e)+' pts)'});\n var c2=calc(clamp(r+tot,0,MAX),st.norm),dA=Math.round(c.s),dB=Math.round(c2.s),diff=dB-dA;\n $('hA').textContent=dA;$('hB').textContent=dB;\n $('hMsg').textContent=diff===0?'No change. Try moving a slider.':'Same person, same mind. The number moved by '+(diff>0?'+':'')+diff+' points.';\n drawCurve($('c2'),[{s:c.s,l:'As taken: '+dA,c:'a'},{s:c2.s,l:'Other day: '+dB,c:'b'}]);\n // Section 4\n var dec=+$('old').value,fmt=document.querySelector('input[name=fmt]:checked').value,band=$('bandChk').checked;\n var base=c.s,notes=[];\n if(fmt==='best'){var br=0;(sample?[{pts:1,max:1}]:st.res).forEach(function(x){br=Math.max(br,x.pts/x.max)});base=calc(br*MAX,st.norm).s;\n  notes.push('Best item only: one good moment is reported as if it were the whole test.')}\n var s=clamp(base+3*dec,40,160),out;\n if(dec)notes.push('Old norms: average scores on many tests rose during the 1900s. This is called the Flynn effect. An old comparison group makes you look better. We add 3 points per decade, a rough figure often quoted.');\n if(fmt==='whole'||fmt==='best')out=String(Math.round(s));\n else if(fmt==='precise'){out=(s+((r*7.31)%1)/10).toFixed(4);notes.push('Four decimals look exact. A short test cannot measure anything this finely.')}\n else if(fmt==='pct'){out='Top '+ord(100-cdf((s-100)/15)*100);notes.push('A percentile can sound more impressive. \"Top 25%\" and \"110\" are the same result here.')}\n else {out=label(s);notes.push('A label feels like a fact about you. It is only a range of numbers with a name.')}\n if(band&&fmt!=='label'&&fmt!=='pct')out+=' ± 15';\n notes.unshift(st.norm==='avg'?'Comparison group: '+n.n+'. Try \"Pick the most flattering group\".':'Comparison group: '+n.n+'. Changing the group changed the number. Your answers stayed the same.');\n notes.push(band?'Error band on: every test score has measurement error. If you retook this tiny test, your score could land anywhere in the band (±15 is made up).':'No error band: the number looks certain. It is not.');\n $('rep').textContent=out;\n var tl=$('tricks');tl.innerHTML='';notes.forEach(function(t){tl.appendChild(el('li',{},t))});\n drawCurve($('c3'),[{s:s,l:'Reported: '+Math.round(s),c:'a'}],band?[s-15,s+15]:null);\n}\nupdate();\n})();\n</script>\n</body>\n</html>",
