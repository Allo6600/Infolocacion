 "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Five-Seven Squeeze</title>\n<style>\n:root{--bg:#f7f3ea;--ink:#2a2622;--muted:#6d645a;--accent:#8a3b2e;--card:#fffdf8;--line:#d8cfc0;--ok:#2f7a4a;--bad:#a33a2a;--focus:#1f5fbf}\n@media (prefers-color-scheme: dark){:root{--bg:#1d1b19;--ink:#ece5d8;--muted:#a79d8f;--accent:#e08a74;--card:#26231f;--line:#3d3830;--ok:#7fd196;--bad:#f09a8a;--focus:#8ab6ff}}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;line-height:1.5;min-height:100vh}\nmain{max-width:720px;margin:0 auto;padding:16px}\nh1{font-family:\"Yu Mincho\",\"Hiragino Mincho ProN\",Georgia,serif;font-size:1.6rem;margin:4px 0;color:var(--accent)}\nh2{font-size:1.05rem;margin:0 0 8px}\n.sub{color:var(--muted);margin:0 0 16px;font-size:.95rem}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:14px}\nlabel{display:block;font-weight:600;margin-bottom:6px}\ntextarea{width:100%;min-height:90px;font:inherit;font-size:1rem;padding:10px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink);resize:vertical}\n.ln-input{width:100%;font:inherit;font-size:1rem;min-height:44px;padding:8px 10px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}\nbutton{font:inherit;min-height:44px;padding:8px 16px;border-radius:8px;border:1px solid var(--accent);background:var(--accent);color:#fff;cursor:pointer}\nbutton.ghost{background:transparent;color:var(--accent)}\nbutton:focus-visible,textarea:focus-visible,.ln-input:focus-visible,input[type=checkbox]:focus-visible{outline:3px solid var(--focus);outline-offset:2px}\n.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px}\n.toggle{display:flex;align-items:center;gap:10px;min-height:44px;font-weight:600;margin:0;cursor:pointer}\n.toggle input{width:20px;height:20px}\n.poem{display:flex;flex-direction:column;align-items:center;gap:8px;padding:14px 0 4px;font-family:\"Yu Mincho\",\"Hiragino Mincho ProN\",Georgia,serif;font-size:1.25rem;min-height:12px}\n.line{text-align:center;word-break:break-word}\n.count{font-family:system-ui,sans-serif;font-size:.8rem;color:var(--muted)}\n.count.good{color:var(--ok)}\n.count.bad{color:var(--bad)}\n.note{color:var(--muted);font-size:.9rem;margin:8px 0 0}\n.thought{font-family:\"Yu Mincho\",\"Hiragino Mincho ProN\",Georgia,serif;font-size:1.15rem;margin:4px 0 10px}\n.keys{margin-bottom:12px}\n.keys span{display:inline-block;margin:3px;padding:4px 12px;border-radius:999px;border:1px solid var(--line);font-size:.9rem}\n.keys span.hit{border-color:var(--ok);color:var(--ok);font-weight:600}\n.slot{display:grid;gap:4px;margin-bottom:10px}\n.score{font-size:1.4rem;font-weight:700;margin:10px 0 4px}\n#result p{margin:4px 0}\n</style>\n</head>\n<body>\n<main>\n<h1>Five-Seven Squeeze</h1>\n<p class=\"sub\">Squeeze a thought into the sound pattern of Japanese verse.</p>\n\n<div class=\"card\">\n  <label class=\"toggle\"><input type=\"checkbox\" id=\"tanka\"> Tanka pattern (5-7-5-7-7) instead of haiku (5-7-5)</label>\n</div>\n\n<section class=\"card\" aria-labelledby=\"h-comp\">\n  <h2 id=\"h-comp\">1. Compress a thought</h2>\n  <label for=\"src\">Your thought (separate words or phrases with spaces)</label>\n  <textarea id=\"src\" placeholder=\"e.g. I walk home slowly while the sky turns orange\"></textarea>\n  <div class=\"row\">\n    <button id=\"go\" type=\"button\">Compress</button>\n    <button id=\"clr\" type=\"button\" class=\"ghost\">Clear</button>\n  </div>\n  <div id=\"out\" class=\"poem\" aria-live=\"polite\"></div>\n  <p id=\"note\" class=\"note\"></p>\n</section>\n\n<section class=\"card\" aria-labelledby=\"h-game\">\n  <h2 id=\"h-game\">2. Round</h2>\n  <p>Write a verse that says this thought. Hit each line's sound count and use the key words.</p>\n  <p id=\"thought\" class=\"thought\"></p>\n  <div id=\"keys\" class=\"keys\" aria-label=\"Key words\"></div>\n  <div id=\"slots\"></div>\n  <div class=\"row\">\n    <button id=\"score\" type=\"button\">Score</button>\n    <button id=\"next\" type=\"button\" class=\"ghost\">New thought</button>\n  </div>\n  <div id=\"result\" aria-live=\"polite\"></div>\n  <p class=\"note\">Best score this visit: <span id=\"best\">0</span></p>\n</section>\n\n<p class=\"note\">Sound counts are estimates. English uses vowel groups. Japanese counts each kana as one sound and each kanji as two.</p>\n</main>\n\n<script>\n(function(){\n  const $ = id => document.getElementById(id);\n\n  // Filler words that are removed first when compressing.\n  const STOP = new Set([\"a\",\"an\",\"the\",\"is\",\"am\",\"are\",\"was\",\"were\",\"be\",\"been\",\"to\",\"of\",\"and\",\"but\",\"so\",\"very\",\"really\",\"just\",\"that\",\"this\",\"it\",\"in\",\"on\",\"at\",\"for\",\"with\",\"i\",\"me\",\"my\",\"we\",\"our\",\"or\",\"as\",\"by\",\"from\",\"の\",\"は\",\"が\",\"を\",\"に\",\"で\",\"と\",\"も\"]);\n\n  const THOUGHTS = [\n    {text:\"I miss the sound of rain on the old roof.\", keys:[\"rain\",\"roof\",\"miss\"]},\n    {text:\"The first cold morning, I finally felt calm.\", keys:[\"morning\",\"cold\",\"calm\"]},\n    {text:\"Our small boat drifts slowly toward the moon.\", keys:[\"boat\",\"moon\",\"slowly\"]},\n    {text:\"A cat sleeps in the sun by the window.\", keys:[\"cat\",\"sun\",\"window\"]}\n  ];\n\n  let cur = 0;\n  let best = 0;\n\n  // Rough English syllable count using vowel groups.\n  function englishSyl(w){\n    w = w.toLowerCase().replace(/[^a-z]/g, \"\");\n    if (!w) return 0;\n    if (w.length <= 3) return 1;\n    w = w.replace(/(?:[^laeiouy]es|[^laeiouy]ed|[^laeiouy]e)$/, \"\").replace(/^y/, \"\");\n    const m = w.match(/[aeiouy]{1,2}/g);\n    return m ? m.length : 1;\n  }\n\n  // Japanese: each kana is one sound (small kana add none), each kanji is two (estimate).\n  function sounds(word){\n    let jp = 0;\n    for (const ch of word){\n      if (/[\\u3041-\\u3096\\u30a1-\\u30fa\\u30fc]/.test(ch)){\n        if (!/[ぁぃぅぇぉゃゅょゎァィゥェォャュョヮ]/.test(ch)) jp++;\n      } else if (/[\\u4e00-\\u9fff]/.test(ch)){\n        jp += 2;\n      }\n    }\n    return jp + englishSyl(word.replace(/[^A-Za-z']/g, \"\"));\n  }\n\n  function tokens(text){\n    return text.trim().split(/\\s+/).filter(Boolean)\n      .map(w => ({w, n: sounds(w)}))\n      .filter(t => t.n > 0);\n  }\n\n  function lineSounds(text){\n    return tokens(text).reduce((s, t) => s + t.n, 0);\n  }\n\n  // Greedy fit: keep words in order, drop filler first, skip words that do not fit.\n  function compress(text, pattern){\n    const all = tokens(text);\n    let pool = all.filter(t => !STOP.has(t.w.toLowerCase().replace(/[^a-z'\\u3041-\\u3096\\u30a1-\\u30fa\\u4e00-\\u9fff]/g, \"\")));\n    if (!pool.length) pool = all;\n    const used = new Set();\n    const lines = [];\n    for (const target of pattern){\n      let sum = 0;\n      const picked = [];\n      pool.forEach((t, k) => {\n        if (!used.has(k) && sum < target && sum + t.n <= target){\n          sum += t.n;\n          picked.push(k);\n          used.add(k);\n        }\n      });\n      lines.push({target, sum, text: picked.map(k => pool[k].w).join(\" \")});\n    }\n    const left = pool.filter((_, k) => !used.has(k)).map(t => t.w);\n    return {lines, left, removed: all.length - pool.length, total: all.length, kept: used.size};\n  }\n\n  function currentPattern(){\n    return $(\"tanka\").checked ? [5,7,5,7,7] : [5,7,5];\n  }\n\n  // Compress section\n  function renderCompress(){\n    const out = $(\"out\"), note = $(\"note\");\n    out.textContent = \"\";\n    note.textContent = \"\";\n    const r = compress($(\"src\").value, currentPattern());\n    if (!r.total){\n      note.textContent = \"Type a thought first.\";\n      return;\n    }\n    let short = false;\n    r.lines.forEach(ln => {\n      if (ln.sum < ln.target) short = true;\n      const d = document.createElement(\"div\");\n      d.className = \"line\";\n      d.textContent = ln.text || \"(no words fit)\";\n      const c = document.createElement(\"span\");\n      c.className = \"count\";\n      c.textContent = \" [\" + ln.sum + \"/\" + ln.target + \"]\";\n      d.appendChild(c);\n      out.appendChild(d);\n    });\n    let msg = \"Kept \" + r.kept + \" of \" + r.total + \" words. Removed \" + r.removed + \" filler words.\";\n    if (r.left.length) msg += \" Left out: \" + r.left.join(\", \") + \".\";\n    if (short) msg += \" Some lines are short. Try other words to fill the gap.\";\n    note.textContent = msg;\n  }\n\n  // Game section\n  function updateCount(i){\n    const inp = $(\"ln\" + i), c = $(\"c\" + i);\n    const t = Number(inp.dataset.target);\n    const n = lineSounds(inp.value);\n    c.textContent = n + \" / \" + t + (n === t ? \" ✓\" : \"\");\n    c.className = \"count \" + (n === t ? \"good\" : (inp.value.trim() ? \"bad\" : \"\"));\n  }\n\n  function buildSlots(){\n    const pattern = currentPattern();\n    const vals = Array.from(document.querySelectorAll(\".ln-input\")).map(i => i.value);\n    const wrap = $(\"slots\");\n    wrap.textContent = \"\";\n    pattern.forEach((target, i) => {\n      const row = document.createElement(\"div\");\n      row.className = \"slot\";\n      const lab = document.createElement(\"label\");\n      lab.htmlFor = \"ln\" + i;\n      lab.textContent = \"Line \" + (i + 1) + \" (\" + target + \" sounds)\";\n      const inp = document.createElement(\"input\");\n      inp.type = \"text\";\n      inp.id = \"ln\" + i;\n      inp.className = \"ln-input\";\n      inp.autocomplete = \"off\";\n      inp.value = vals[i] || \"\";\n      inp.dataset.target = target;\n      inp.addEventListener(\"input\", () => updateCount(i));\n      const cnt = document.createElement(\"span\");\n      cnt.className = \"count\";\n      cnt.id = \"c\" + i;\n      row.append(lab, inp, cnt);\n      wrap.appendChild(row);\n    });\n    pattern.forEach((_, i) => updateCount(i));\n  }\n\n  function setupRound(){\n    const t = THOUGHTS[cur];\n    $(\"thought\").textContent = \"\\u201C\" + t.text + \"\\u201D\";\n    const keys = $(\"keys\");\n    keys.textContent = \"\";\n    t.keys.forEach(k => {\n      const s = document.createElement(\"span\");\n      s.textContent = k;\n      keys.appendChild(s);\n    });\n    $(\"result\").textContent = \"\";\n    buildSlots();\n  }\n\n  function scoreRound(){\n    const t = THOUGHTS[cur];\n    const inputs = Array.from(document.querySelectorAll(\".ln-input\"));\n    let okLines = 0;\n    const parts = [];\n    inputs.forEach(inp => {\n      parts.push(inp.value);\n      if (lineSounds(inp.value) === Number(inp.dataset.target)) okLines++;\n    });\n    const text = parts.join(\" \");\n    let hits = 0;\n    const chips = $(\"keys\").children;\n    t.keys.forEach((k, i) => {\n      const ok = new RegExp(\"\\\\b\" + k + \"\\\\b\", \"i\").test(text);\n      if (ok) hits++;\n      chips[i].classList.toggle(\"hit\", ok);\n    });\n    const linePts = Math.round(60 * okLines / inputs.length);\n    const keyPts = Math.round(40 * hits / t.keys.length);\n    const total = linePts + keyPts;\n    best = Math.max(best, total);\n    $(\"best\").textContent = best;\n\n    const res = $(\"result\");\n    res.textContent = \"\";\n    const s = document.createElement(\"p\");\n    s.className = \"score\";\n    s.textContent = total + \" / 100\";\n    const a = document.createElement(\"p\");\n    a.textContent = \"Lines with the right sound count: \" + okLines + \" of \" + inputs.length + \".\";\n    const b = document.createElement(\"p\");\n    b.textContent = \"Key words used: \" + hits + \" of \" + t.keys.length + \".\";\n    const f = document.createElement(\"p\");\n    f.textContent = total >= 90 ? \"Excellent. The verse fits the pattern and the thought.\"\n      : total >= 60 ? \"Good. Fix the lines that are off.\"\n      : \"Keep trying. Check each count and use the key words.\";\n    res.append(s, a, b, f);\n  }\n\n  $(\"tanka\").addEventListener(\"change\", buildSlots);\n  $(\"go\").addEventListener(\"click\", renderCompress);\n  $(\"clr\").addEventListener(\"click\", () => {\n    $(\"src\").value = \"\";\n    $(\"out\").textContent = \"\";\n    $(\"note\").textContent = \"\";\n  });\n  $(\"score\").addEventListener(\"click\", scoreRound);\n  $(\"next\").addEventListener(\"click\", () => {\n    let n;\n    do { n = Math.floor(Math.random() * THOUGHTS.length); }\n    while (THOUGHTS.length > 1 && n === cur);\n    cur = n;\n    setupRound();\n  });\n\n  $(\"src\").placeholder = \"e.g. I walk home slowly while the sky turns orange\";\n  setupRound();\n})();\n</script>\n</body>\n</html>",
